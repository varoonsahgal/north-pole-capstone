# We reuse the account's default VPC and its public subnets.
# "data" blocks only LOOK THINGS UP. They never create or delete anything.
data "aws_vpc" "default" {
  default = true
}

data "aws_subnets" "default" {
  filter {
    name   = "vpc-id"
    values = [data.aws_vpc.default.id]
  }

  filter {
    name   = "default-for-az"
    values = ["true"]
  }
}
